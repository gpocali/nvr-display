#!/bin/ash
while true; do
    timeout 1 wget $(cat /etc/nvr-display/forecast/address) -O- | head -c -1 > /tmp/forecast || echo -n Forecast Unavailable. > /tmp/forecast
    echo -n "$(timeout 1 wget $(cat /etc/nvr-display/temperature/address) -O- | head -n 1 || echo -n "--")° F" > /tmp/temperature
    sleep 60
done
