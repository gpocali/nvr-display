#!/bin/ash
echo $(date) - Starting Timelapse Downloader

# Source the configuration file
. /etc/nvr-display/nvr-display.conf

error=0

if [[ "$DOWNLOADER_INTERVAL" == "" ]]; then
    echo "Interval must be defined in the configuration file"
    error=1
fi

if [[ "$DOWNLOADER_INPUT_STREAM" == "" ]]; then
    echo "Input Stream must be defined in the configuration file"
    error=1
else
    echo Using inputStream: $DOWNLOADER_INPUT_STREAM
fi

if [ $error -eq 1 ]; then
    exit 1
fi

path=/tmp/timelapse
if [ ! -e $path ]; then
    echo $(date) - Making Directory $path
    mkdir -p $path
fi

counter=0
while true; do
    wget --timeout=1 -q $DOWNLOADER_INPUT_FLAGS "$DOWNLOADER_INPUT_STREAM" -O $path/timelapse$counter.jpg && ln -s -f $path/timelapse$counter.jpg $path/timelapse.jpg && echo $(date) - timelapse$counter.jpg Downloaded || echo $(date) - Download Failed
    
    if [ $counter -lt 10 ]; then
        counter=$(($counter+1))
    else
        counter=0
    fi
    sleep $DOWNLOADER_INTERVAL
done